{
  "$comment": "Whitelist of upstream files mirrored into upstream/<name>/. Only sync/pull.mjs writes there. Each transform must match exactly `count` times or the sync fails.",
  "repos": {
    "unredacted": {
      "url": "https://github.com/jyr-ai/UNREDACTED",
      "ref": "main",
      "enabled": true,
      "license": "AGPL-3.0",
      "include": [
        "LICENSE",
        "server/services/rssFeed.js",
        "server/routes/liveStreams.js",
        "src/components/LiveNewsPanel.jsx",
        "src/components/ErrorBoundary.jsx",
        "src/components/ui/Band.jsx",
        "src/components/ui/Card.jsx",
        "src/components/ui/CardTitle.jsx",
        "src/components/ui/SourceFooter.jsx",
        "src/components/ui/Legend.jsx",
        "src/components/ui/ChartTooltip.jsx",
        "src/theme/index.js",
        "src/theme/tokens.js",
        "src/theme/dark.js"
      ],
      "exclude": [],
      "transforms": [
        {
          "file": "src/components/LiveNewsPanel.jsx",
          "find": "const ORANGE = '#FF8000';",
          "replace": "const ORANGE = '#E6A817';",
          "count": 1
        }
      ]
    },
    "ade": {
      "url": "https://github.com/adayo22-byte/ADE-INVESTMENTS",
      "ref": "main",
      "enabled": true,
      "$comment": "Public repo (no token needed), used with the owner's permission. S and LC are exported so the app can overlay live Yahoo data (adapters/ade-live.js); TD (the dashboard's 'today') is the real clock so ADE's own staleness flags stay honest. Colour map: sync/transforms/ade-colors.json. Cosmetic transforms are optional: if upstream changes the matched text, sync warns and leaves it. The last four transforms make ADE's Options view null-safe: upstream calls pcRatio.toFixed and skew.toFixed unguarded while its published data has them null, so the tab crashes for every ticker. The rateSens transform shows n/a for a ticker with no rate sensitivity (user-added tickers: Yahoo has no such field).",
      "derive": "ade",
      "include": [
        "src/ade-portfolio-v6.jsx",
        ".claude/skills/ade-*/**",
        "docs/ADE-*.md",
        "docs/METHODOLOGY.md",
        "tools/render_check.cjs",
        "tools/healthcheck.cjs",
        "tools/rank.py",
        "tools/scrub_positions.py",
        "tools/private_terms.sha256"
      ],
      "exclude": [],
      "transforms": [
        {
          "file": "src/ade-portfolio-v6.jsx",
          "find": "\nconst S={",
          "replace": "\nexport const S={",
          "count": 1
        },
        {
          "file": "src/ade-portfolio-v6.jsx",
          "find": "\nconst LC={",
          "replace": "\nexport const LC={",
          "count": 1
        },
        {
          "file": "src/ade-portfolio-v6.jsx",
          "find": "\nconst MACRO={",
          "replace": "\nexport const MACRO={",
          "count": 1
        },
        {
          "file": "src/ade-portfolio-v6.jsx",
          "type": "regex",
          "find": "const TD=new Date\\([^)]*\\);",
          "replace": "const TD=new Date();",
          "count": 1,
          "optional": true
        },
        {
          "file": "src/ade-portfolio-v6.jsx",
          "type": "colorMap",
          "map": "sync/transforms/ade-colors.json"
        },
        {
          "file": "src/ade-portfolio-v6.jsx",
          "find": "'IBM Plex Mono',monospace",
          "replace": "'JetBrains Mono',ui-monospace,monospace",
          "count": 1,
          "optional": true
        },
        {
          "file": "src/ade-portfolio-v6.jsx",
          "find": "'Instrument Sans',sans-serif",
          "replace": "'Josefin Sans',system-ui,sans-serif",
          "count": 1,
          "optional": true
        },
        {
          "file": "src/ade-portfolio-v6.jsx",
          "find": "family=IBM+Plex+Mono:wght@300;400;500;600;700&family=Instrument+Sans:wght@400;500;600;700",
          "replace": "family=JetBrains+Mono:wght@300;400;500;600;700&family=Josefin+Sans:wght@400;500;600;700",
          "count": 1,
          "optional": true
        },
        {
          "file": "src/ade-portfolio-v6.jsx",
          "find": "rgba(77,166,255,0.08)",
          "replace": "rgba(126,145,232,0.08)",
          "count": 1,
          "optional": true
        },
        {
          "file": "src/ade-portfolio-v6.jsx",
          "find": "minHeight:\"100vh\"",
          "replace": "minHeight:\"calc(100dvh - var(--nav-h, 66px))\"",
          "count": 1,
          "optional": true
        },
        {
          "file": "src/ade-portfolio-v6.jsx",
          "find": "position:\"sticky\",top:0,zIndex:200",
          "replace": "position:\"sticky\",top:\"var(--nav-h, 66px)\",zIndex:90",
          "count": 1,
          "optional": true
        },
        {
          "file": "src/ade-portfolio-v6.jsx",
          "find": "stock.options.pcRatio.toFixed(2)",
          "replace": "(stock.options.pcRatio==null?\"n/a\":stock.options.pcRatio.toFixed(2))",
          "count": 2,
          "optional": true
        },
        {
          "file": "src/ade-portfolio-v6.jsx",
          "find": "v:`${skew>0?\"+\":\"\"}${skew.toFixed(1)}%`",
          "replace": "v:skew==null?\"n/a\":`${skew>0?\"+\":\"\"}${skew.toFixed(1)}%`",
          "count": 1,
          "optional": true
        },
        {
          "file": "src/ade-portfolio-v6.jsx",
          "find": "v:`${stock.options.ivRank}%`",
          "replace": "v:stock.options.ivRank==null?\"n/a\":`${stock.options.ivRank}%`",
          "count": 2,
          "optional": true
        },
        {
          "file": "src/ade-portfolio-v6.jsx",
          "find": "v:`${stock.options.ivPctl}%`",
          "replace": "v:stock.options.ivPctl==null?\"n/a\":`${stock.options.ivPctl}%`",
          "count": 1,
          "optional": true
        },
        {
          "file": "src/ade-portfolio-v6.jsx",
          "find": "Rate sensitivity: {stock.rateSens>0.5?\"HIGH\":stock.rateSens>0.2?\"MED\":\"LOW\"} ({(stock.rateSens*100).toFixed(0)}%)",
          "replace": "Rate sensitivity: {stock.rateNote||\"n/a\"}",
          "count": 1,
          "optional": true
        },
        {
          "file": "src/ade-portfolio-v6.jsx",
          "type": "regex",
          "find": "(animation:\"pulse 2s ease-in-out infinite\"\\}\\}/>\\n)\\s*REFRESHED[^\\n]*\\n",
          "replace": "$1 {(globalThis.__ADE_LIVE__||{}).banner||\"\"}\n",
          "count": 1,
          "optional": true
        },
        {
          "file": "src/ade-portfolio-v6.jsx",
          "find": "{l:\"Fwd P/E\",v:`${stock.fwdPE}x`,c:\"#7E91E8\"}",
          "replace": "{l:\"Fwd P/E\",v:stock.fwdPE>0?`${stock.fwdPE}x`:(stock.fwdPENote||\"n/a\"),c:\"#7E91E8\"}",
          "count": 1,
          "optional": true
        },
        {
          "file": "src/ade-portfolio-v6.jsx",
          "find": "{l:\"Fwd P/E\",v:`${stock.fwdPE}x`,c:stock.fwdPE<20?G:stock.fwdPE<35?Y:R}",
          "replace": "{l:\"Fwd P/E\",v:stock.fwdPE>0?`${stock.fwdPE}x`:(stock.fwdPENote||\"n/a\"),c:stock.fwdPE>0?(stock.fwdPE<20?G:stock.fwdPE<35?Y:R):\"#9A8F82\"}",
          "count": 1,
          "optional": true
        },
        {
          "file": "src/ade-portfolio-v6.jsx",
          "find": "color:stock.rateSens>0.5?\"#E6A817\":\"#9A8F82\"",
          "replace": "color:stock.rateNote&&stock.rateNote.startsWith(\"HIGH\")?\"#E6A817\":\"#9A8F82\"",
          "count": 1,
          "optional": true
        },
        {
          "file": "src/ade-portfolio-v6.jsx",
          "find": "CPI {MACRO.cpi}% (↓{MACRO.cpiPrior}%)",
          "replace": "CPI {MACRO.cpi==null?\"n/a\":MACRO.cpi+\"%\"}{MACRO.cpiPrior==null?\"\":` (prior ${MACRO.cpiPrior}%)`}",
          "count": 1,
          "optional": true
        },
        {
          "file": "src/ade-portfolio-v6.jsx",
          "find": "CPI {MACRO.cpi}% • Fed:",
          "replace": "CPI {MACRO.cpi==null?\"n/a\":MACRO.cpi+\"%\"} • Fed:",
          "count": 1,
          "optional": true
        },
        {
          "file": "src/ade-portfolio-v6.jsx",
          "type": "regex",
          "find": "v:(`\\$\\{stock\\.fund\\.metrics\\.(\\w+)[^`]*`),c:",
          "replace": "v:stock.fund.metrics.$2==null?\"n/a\":$1,c:",
          "count": 7,
          "optional": true
        },
        {
          "file": "src/ade-portfolio-v6.jsx",
          "type": "regex",
          "find": "<strong style=\\{\\{color:\"#B8AE92\"\\}\\}>WHAT'S TRUSTED:</strong>[^\\n]*\\n",
          "replace": "{(globalThis.__ADE_LIVE__||{}).legend||\"\"}\n",
          "count": 1,
          "optional": true
        },
        {
          "file": "src/ade-portfolio-v6.jsx",
          "type": "regex",
          "find": " signals — [A-Z][a-z]{2} \\d{1,2}, \\d{4} — Not investment advice",
          "replace": " signals — ADE text from {(globalThis.__ADE_LIVE__||{}).adeDate||\"n/a\"}; numbers live — Not investment advice",
          "count": 1,
          "optional": true
        },
        {
          "file": "src/ade-portfolio-v6.jsx",
          "find": "[\"snapshot\",\"market\",\"exit\"].map(v=>",
          "replace": "[\"snapshot\",\"market\"].map(v=>",
          "count": 1,
          "optional": true
        },
        {
          "file": "src/ade-portfolio-v6.jsx",
          "find": "{tickers.length} positions • Signal-weighted overview",
          "replace": "{tickers.length} tickers • Signal-weighted overview",
          "count": 1,
          "optional": true
        },
        {
          "file": "src/ade-portfolio-v6.jsx",
          "find": "sub:`IV higher ${stock.options.ivPctl}% of days`",
          "replace": "sub:stock.options.ivPctl==null?\"needs 20 daily IV readings\":`IV higher ${stock.options.ivPctl}% of days`",
          "count": 1,
          "optional": true
        },
        {
          "file": "src/ade-portfolio-v6.jsx",
          "find": ">KEY INVESTMENT THEMES</div>",
          "replace": ">KEY INVESTMENT THEMES · written by ADE, {(globalThis.__ADE_LIVE__||{}).adeDate||\"\"}, not refreshed here</div>",
          "count": 1,
          "optional": true
        },
        {
          "file": "src/ade-portfolio-v6.jsx",
          "find": "{l:\"Implied Move\",v:`±${stock.options.impliedMove}%`,c:P,sub:`Mkt pricing $${(price*stock.options.impliedMove/100).toFixed(0)} swing at earnings`,icon:\"⚡\"}",
          "replace": "{l:\"Implied Move\",v:stock.options.impliedMove==null?\"n/a\":`±${stock.options.impliedMove}%`,c:P,sub:stock.options.impliedMove==null?\"no earnings straddle priced yet\":`Mkt pricing $${(price*stock.options.impliedMove/100).toFixed(0)} swing at earnings`,icon:\"⚡\"}",
          "count": 1,
          "optional": true
        },
        {
          "file": "src/ade-portfolio-v6.jsx",
          "type": "fontScale",
          "sizes": {
            "5": 10,
            "6": 11,
            "7": 12,
            "8": 13,
            "9": 14,
            "10": 15,
            "11": 16,
            "12": 17,
            "13": 18,
            "14": 19,
            "16": 20,
            "18": 22,
            "20": 24,
            "22": 26,
            "24": 28,
            "26": 30,
            "28": 32,
            "30": 34,
            "36": 40
          },
          "gridFactor": 1.5
        }
      ]
    },
    "jians": {
      "url": "https://github.com/jyr-ai/Jians_finance",
      "ref": "main",
      "enabled": false,
      "$enabled": "Phase 3.",
      "include": [
        ".claude/skills/fisher-stock-screen/**",
        ".claude/skills/swing-biotech-screen/**",
        ".claude/agents/dd-fact-checker.md",
        "fisher_metrics/**",
        "stock_technicals/**",
        "swing_trader/**",
        "run_fisher_metrics.py",
        "run_technicals.py",
        "master-rankings.md",
        "conftest.py",
        "tests/test_fisher_metrics.py",
        "tests/test_stock_technicals.py",
        "tests/test_swing_*.py"
      ],
      "exclude": [
        ".mcp.json",
        "swing_trader/backtest/**",
        "**/__pycache__/**"
      ],
      "transforms": []
    },
    "facai": {
      "url": "https://github.com/jyr-ai/facai",
      "ref": "feat-personal",
      "enabled": false,
      "$enabled": "Phase 4. The portfolio advisor lives on feat-personal, not the default branch.",
      "license": "Apache-2.0",
      "include": [
        "LICENSE",
        "NOTICE",
        "frontend/src/lib/fidelity-csv-parser.ts",
        "python/valuecell/agents/portfolio_advisor/prompts.py",
        "python/valuecell/agents/portfolio_advisor/valuation.py"
      ],
      "exclude": [],
      "transforms": []
    }
  }
}
