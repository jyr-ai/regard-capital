# Login gate (required)
APP_PASSWORD=
SESSION_SECRET=   # 32+ random bytes, e.g. `openssl rand -hex 32`

# Optional: resolves YouTube live-stream IDs via the Data API instead of scraping
YOUTUBE_API_KEY=

# ADE System live data
CRON_SECRET=                  # Vercel Cron sends this as a bearer token to /api/cron/refresh-ade
UPSTASH_REDIS_REST_URL=       # unset = in-memory store (resets on restart)
UPSTASH_REDIS_REST_TOKEN=
ANTHROPIC_API_KEY=            # optional: Claude drafts narratives for tickers users add

# Phase 3+
# SEC_USER_AGENT="Regard Capital research (you@example.com)"
